8N>","text":"Отлично! Теперь пришли название агента (например: «Поддержка клиентов»).","additionalFields":{"appendAttribution":false}},"id":"5234bdf4-bee8-4426-9b4a-e2361b5e4e2b","name":"TG: Ask Agent Name2","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[-304,1008]},{"parameters":{"operation":"executeQuery","query":"INSERT INTO agents (user_id, elevenlabs_agent_id, name) SELECT u.id, s.temp_data, '{{ $json.text.replace(/'/g, \"''\") }}' FROM users u JOIN user_sessions s ON s.telegram_id = u.telegram_id WHERE u.telegram_id = {{$json.telegram_id}}; UPDATE user_sessions SET state = 'idle', temp_data = NULL WHERE telegram_id = {{$json.telegram_id}};","options":{}},"id":"624e9d5c-da26-43b2-8651-f9af4ce53881","name":"MySQL: Insert Agent2","type":"n8n-nodes-base.mySql","typeVersion":2.4,"position":[-528,1168]},{"parameters":{"chatId":"<CONFIGURE_IN_N8N>","text":"✅ Агент добавлен! Напиши /agents чтобы увидеть его.","additionalFields":{"appendAttribution":false}},"id":"9a31a272-ecc3-4bfc-93ac-01db4939576f","name":"TG: Agent Added2","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[-304,1168]},{"parameters":{"updates":["*"],"additionalFields":{}},"id":"0edf43b5-70b7-4133-9e74-87eaf43a6236","name":"Telegram Trigger2","type":"n8n-nodes-base.telegramTrigger","typeVersion":1.1,"position":[-1648,208]},{"parameters":{"jsCode":"const u = $input.item.json;\nconst msg = u.message;\nconst cb  = u.callback_query;\nconst telegram_id = (msg?.from?.id) ?? (cb?.from?.id);\nconst chat_id     = (msg?.chat?.id) ?? (cb?.message?.chat?.id);\nconst username    = (msg?.from?.username) ?? (cb?.from?.username) ?? null;\nconst text        = msg?.text ?? null;\nconst callback    = cb?.data ?? null;\nconst cb_id       = cb?.id ?? null;\nlet kind = 'other';\nif (callback) kind = 'callback';\nelse if (text?.startsWith('/')) kind = 'command';\nelse if (text) kind = 'text';\nreturn { telegram_id, chat_id, username, text, callback, cb_id, kind };"},"id":"d998ce74-7346-41b0-8e32-d0791bfdc85b","name":"Parse Update2","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1424,208]},{"parameters":{"operation":"executeQuery","query":"INSERT INTO users (telegram_id, username) VALUES ({{$json.telegram_id}}, {{ $json.username ? \"'\" + $json.username.replace(/'/g, \"''\") + \"'\" : 'NULL' }}) ON DUPLICATE KEY UPDATE username = VALUES(username); INSERT INTO user_sessions (telegram_id, state) VALUES ({{$json.telegram_id}}, 'idle') ON DUPLICATE KEY UPDATE telegram_id = telegram_id; SELECT u.id AS user_id, s.selected_agent_id, s.state FROM users u LEFT JOIN user_sessions s ON s.telegram_id = u.telegram_id WHERE u.telegram_id = {{$json.telegram_id}};","options":{}},"id":"13e6858c-fe57-456d-903e-6b3fe9d1ab28","name":"Upsert User + Get Session2","type":"n8n-nodes-base.mySql","typeVersion":2.4,"position":[-1216,208]},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"c1","leftValue":"={{$json.text}}","rightValue":"/start","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"c2a","leftValue":"={{$json.text}}","rightValue":"/agents","operator":{"type":"string","operation":"equals"}},{"id":"c2b","leftValue":"={{$json.callback}}","rightValue":"menu:agents","operator":{"type":"string","operation":"equals"}}],"combinator":"or"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"c3","leftValue":"={{$json.callback}}","rightValue":"^agent:\\d+$","operator":{"type":"string","operation":"regex"}}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"c4kb","leftValue":"={{$json.callback}}","rightValue":"act:kb","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"c4","leftValue":"={{$json.callback}}","rightValue":"^act:(prompt|welcome|kb_text|kb_url)$","operator":{"type":"string","operation":"regex"}}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"c6a","leftValue":"={{$json.text}}","rightValue":"/addagent","operator":{"type":"string","operation":"equals"}},{"id":"c6b","leftValue":"={{$json.callback}}","rightValue":"menu:addagent","operator":{"type":"string","operation":"equals"}}],"combinator":"or"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"c7a","leftValue":"={{$json.kind}}","rightValue":"text","operator":{"type":"string","operation":"equals"}},{"id":"c7b","leftValue":"={{$json.state}}","rightValue":"await_agent_id","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"c8a","leftValue":"={{$json.kind}}","rightValue":"text","operator":{"type":"string","operation":"equals"}},{"id":"c8b","leftValue":"={{$json.state}}","rightValue":"await_agent_name","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"c5a","leftValue":"={{$json.kind}}","rightValue":"text","operator":{"type":"string","operation":"equals"}},{"id":"c5b","leftValue":"={{$json.state}}","rightValue":"idle","operator":{"type":"string","operation":"notEquals"}}],"combinator":"and"}}]},"options":{"fallbackOutput":"extra"}},"id":"08a24fb8-5cfd-483f-a840-0e0454afc84a","name":"Router2","type":"n8n-nodes-base.switch","typeVersion":3.2,"position":[-800,208]},{"parameters":{"chatId":"<CONFIGURE_IN_N8N>","text":"Привет! Я помогу управлять твоими ElevenLabs-агентами.\n\n/agents — список твоих агентов\n/addagent - добавить агента\n","additionalFields":{"appendAttribution":false}},"id":"eea56384-d65b-4456-b760-54b9b5cf566b","name":"TG: Welcome2","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[-528,-112]},{"parameters":{"operation":"executeQuery","query":"SELECT id, name, elevenlabs_agent_id FROM agents WHERE user_id = {{$json.user_id}} ORDER BY id;","options":{}},"id":"f530cd9c-8280-4502-a304-343cb172b0ca","name":"MySQL: Get Agents2","type":"n8n-nodes-base.mySql","typeVersion":2.4,"position":[-528,48]},{"parameters":{"jsCode":"const ctx = $('Build Context2').item.json;\nconst rows = $input.all().map(i => i.json);\nif (rows.length === 0) {\n  return { chat_id: ctx.chat_id, text: 'У тебя пока нет агентов.\\n\\nИспользуй /addagent чтобы добавить агента из ElevenLabs.', reply_markup: null };\n}\nconst keyboard = rows.map(r => ([{ text: r.name || r.elevenlabs_agent_id, callback_data: `agent:${r.id}` }]));\nreturn {\n  chat_id: ctx.chat_id,\n  text: 'Выбери агента:',\n  reply_markup: { inline_keyboard: keyboard }\n};"},"id":"6f8199c8-085a-4fe1-b47d-69e366974b3f","name":"Build Agents Keyboard2","type":"n8n-nodes-base.code","typeVersion":2,"position":[-304,48]},{"parameters":{"method":"POST","url":"https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/sendMessage","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"chat_id\": {{ $json.chat_id }},\n  \"text\": {{ JSON.stringify($json.text) }},\n  \"reply_markup\": {{ $json.reply_markup ? JSON.stringify($json.reply_markup) : '{}' }}\n}","options":{}},"id":"eada87ca-876a-4d04-a443-b0fa638349bd","name":"TG: Send Agents List2","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-80,48]},{"parameters":{"operation":"executeQuery","query":"UPDATE user_sessions SET selected_agent_id = (SELECT id FROM agents WHERE id = {{ Number($json.callback.split(':')[1]) }} AND user_id = {{$json.user_id}}), state = 'idle' WHERE telegram_id = {{$json.telegram_id}}; SELECT a.id, a.name, a.elevenlabs_agent_id FROM agents a WHERE a.id = {{ Number($json.callback.split(':')[1]) }} AND a.user_id = {{$json.user_id}};","options":{}},"id":"c60f50f9-94af-4466-814e-3d595a83d9ba","name":"MySQL: Select Agent2","type":"n8n-nodes-base.mySql","typeVersion":2.4,"position":[-528,208]},{"parameters":{"url":"=https://api.elevenlabs.io/v1/convai/agents/{{$json.elevenlabs_agent_id}}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","options":{}},"id":"60c9cf99-04eb-4946-95f9-e379ef578015","name":"EL: Get Agent2","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-304,208]},{"parameters":{"jsCode":"const ctx = $('Build Context2').item.json;\nconst dbAgent = $('MySQL: Select Agent2').item.json;\nconst elAgent = $input.item.json;\n\nif (!dbAgent || !dbAgent.id) {\n  return { chat_id: ctx.chat_id, text: 'Агент не найден или не принадлежит тебе.', reply_markup: null };\n}\n\nconst prompt  = elAgent?.conversation_config?.agent?.prompt?.prompt || '(не задан)';\nconst welcome = elAgent?.conversation_config?.agent?.first_message  || '(не задан)';\nconst cut = (s, n) => s.length > n ? s.substring(0, n) + '...' : s;\n\nconst kb = [\n  [{ text: '📝 Изменить prompt',          callback_data: 'act:prompt'  }],\n  [{ text: '👋 Изменить welcome',          callback_data: 'act:welcome' }],\n  [{ text: '📚 Обновить knowledge base',   callback_data: 'act:kb'      }],\n  [{ text: '← К списку агентов',          callback_data: 'menu:agents' }],\n];\n\nreturn {\n  chat_id: ctx.chat_id,\n  text: `Агент: *${dbAgent.name || dbAgent.elevenlabs_agent_id}*\\n\\n📝 *Prompt:*\\n${cut(prompt, 200)}\\n\\n👋 *Welcome:*\\n${cut(welcome, 100)}\\n\\nЧто меняем?`,\n  reply_markup: { inline_keyboard: kb }\n};"},"id":"f238c22b-cc13-42c0-b548-8498ad40985c","name":"Build Actions Keyboard2","type":"n8n-nodes-base.code","typeVersion":2,"position":[-80,208]},{"parameters":{"method":"POST","url