ge the prompt to You are a helpful assistant\" → {\"action\":\"update_prompt\",\"value\":\"You are a helpful assistant\"}\nUser: \"set system prompt to Be friendly and concise\" → {\"action\":\"update_prompt\",\"value\":\"Be friendly and concise\"}\nUser: \"add this to kb: Our company was founded in 2020\" → {\"action\":\"add_kb_text\",\"value\":\"Our company was founded in 2020\"}\nUser: \"add url https://example.com to knowledge base\" → {\"action\":\"add_kb_url\",\"value\":\"https://example.com\"}\nUser: \"hello\" → {\"action\":\"unknown\",\"value\":\"\"}"}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":2.2,"position":[144,1520],"id":"027fd56a-a513-4200-828b-593a7ede899b","name":"AI Agent"},{"parameters":{"model":{"__rl":true,"mode":"list","value":"gpt-4.1-mini"},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.2,"position":[96,1728],"id":"ee6b7227-d78d-47eb-aa60-334f7c62ba4a","name":"OpenAI Chat Model"},{"parameters":{"sessionIdType":"customKey","sessionKey":"={{ $('Telegram Trigger2').item.json.message.chat.id }}","contextWindowLength":15},"type":"@n8n/n8n-nodes-langchain.memoryBufferWindow","typeVersion":1.3,"position":[336,1728],"id":"603bd05e-fd73-4b2d-afc2-d893192de99a","name":"Simple Memory"}],"pinData":{},"connections":{"Router2":{"main":[[{"node":"TG: Welcome2","type":"main","index":0}],[{"node":"MySQL: Get Agents2","type":"main","index":0}],[{"node":"MySQL: Select Agent2","type":"main","index":0}],[{"node":"Build KB Menu2","type":"main","index":0}],[{"node":"MySQL: Set State2","type":"main","index":0}],[{"node":"MySQL: Set Await Agent ID2","type":"main","index":0}],[{"node":"MySQL: Save Agent ID Temp2","type":"main","index":0}],[{"node":"MySQL: Insert Agent2","type":"main","index":0}],[{"node":"MySQL: Verify Ownership2","type":"main","index":0}],[{"node":"Check Is Text","type":"main","index":0}]]},"State Switch2":{"main":[[{"node":"EL: Update Prompt2","type":"main","index":0}],[{"node":"EL: Update Welcome2","type":"ma