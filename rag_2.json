    {
      "parameters": {
        "jsCode": "const text = $input.first().json.output;\n\n// 1. Извлекаем ID видео / share token (несколько форматов)\nlet fileId = null;\nconst idPatterns = [\n  /ID видео[:\\s]*([a-zA-Z0-9_-]{5,})/i,\n  /video_file_id[:\\s]*([a-zA-Z0-9_-]{5,})/i,\n  /nextcloud\\.agentura-soft\\.ru\\/(index\\.php\\/)?s\\/([a-zA-Z0-9]+)/\n];\nfor (const pat of idPatterns) {\n  const m = text.match(pat);\n  if (m) { fileId = m[1].trim(); break; }\n}\n\n// 2. Извлекаем таймкод (несколько форматов)\nlet startSec = 0;\nconst timePatterns = [\n  /Таймкод[:\\s]*(\\d{1,3}):(\\d{2})/i,\n  /\\((\\d{1,3}):(\\d{2})\\s*[-–)]/,\n  /\\b(\\d{1,3}):(\\d{2})\\b/\n];\nfor (const pat of timePatterns) {\n  const m = text.match(pat);\n  if (m) {\n    startSec = parseInt(m[1]) * 60 + parseInt(m[2]);\n    break;\n  }\n}\n\n// 3. Формируем video_url (Nextcloud или Google Drive)\nlet videoUrl = null;\n\n// Ищем прямые URL в тексте\nconst ncUrl = text.match(/https:\\/\\/nextcloud\\.agentura-soft\\.ru\\/(index\\.php\\/)?s\\/[a-zA-Z0-9]+\\/download/);\nconst gdUrl = text.match(/https:\\/\\/drive\\.google\\.com\\/file\\/d\\/[a-zA-Z0-9_-]+\\/preview/);\n\nif (ncUrl) {\n  videoUrl = ncUrl[0];\n} else if (gdUrl) {\n  videoUrl = gdUrl[0];\n} else if (fileId) {\n  if (fileId.length > 25) {\n    videoUrl = `https://drive.google.com/file/d/${fileId}/preview`;\n  } else {\n    videoUrl = `https://nextcloud.agentura-soft.ru/index.php/s/${fileId}/download`;\n  }\n}\n\n// 4. Очищаем ответ от служебных строк\nlet answer = text\n  .replace(/^.*ID видео.*$/gm, '')\n  .replace(/^.*Таймкод.*$/gm, '')\n  .replace(/^.*Источник.*$/gm, '')\n  .replace(/^.*video_file_id.*$/gm, '')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nreturn [{\n  json: {\n    answer: answer,\n    video_url: videoUrl,\n    start_time_sec: startSec\n  }\n}];"
      },
