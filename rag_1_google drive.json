        "jsonBody": "={ \"role\": \"reader\", \"type\": \"anyone\" }",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [80, 240],
      "id": "set-permissions",
      "name": "Открыть доступ по ссылке",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "2KWrQBMM4dc15h55",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
