      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1020, 240],
      "id": "read-audio-from-disk",
      "name": "Прочитать аудио с диска"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "data"
            },
            {
              "name": "model",
              "value": "whisper-1"
            },
            {
              "name": "language",
              "value": "ru"
            },
            {
              "name": "response_format",
              "value": "verbose_json"
            },
            {
              "name": "timestamp_granularities[]",
              "value": "segment"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1240, 240],
      "id": "whisper-transcribe",
      "name": "Whisper — транскрипция (API)",
      "credentials": {
        "openAiApi": {
          "id": "PGcbdvVjBsD5s4ky",
          "name": "tasktg"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Получаем данные из предыдущих нод\nconst transcription = $('Whisper — транскрипция (API)').first().json;\nconst driveFile = $('Загрузка на Google Drive').first().json;\nconst webhookData = $('Webhook — приём видео').first().json;\n\nconst title = webhookData.body?.title || driveFile.name || 'Без названия';\nconst description = webhookData.body?.description || '';\nconst fileId = driveFile.id;\n\n// Собираем текст с таймкодами из segments\nlet textWithTimecodes = '';\n\nif (transcription.segments && Array.isArray(transcription.segments)) {\n  for (const seg of transcription.segments) {\n    const startSec = Math.floor(seg.start);\n    const min = Math.floor(startSec / 60);\n    const sec = (startSec % 60).toString().padStart(2, '0');\n    const timecode = `${min}:${sec}`;\n    textWithTimecodes += `(${timecode}) ${seg.text.trim()}\\n`;\n  }\n} else {\n  textWithTimecodes = transcription.text || '';\n}\n\n// Удаляем временный аудио-файл\ntry {\n  const execId = $execution.id;\n  require('fs').unlinkSync(`/tmp/n8n_audio_${execId}.mp3`);\n} catch(e) {}\n\nreturn [{\n  json: {\n    full_text: textWithTimecodes,\n    title: title,\n    description: description,\n    video_file_id: fileId,\n    video_url: `https://drive.google.com/file/d/${fileId}/preview`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1460, 240],
      "id": "format-transcription",
      "name": "Форматирование транскрипции"
    },
    {
      "parameters": {
        "mode": "insert",
        "qdrantCollection": {
          "__rl": true,
          "value": "fobo",
          "mode": "list",
          "cachedResultName": "fobo"
        },
        "embeddingBatchSize": 150,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [1740, 240],
      "id": "qdrant-insert",
      "name": "Qdrant — сохранение",
      "credentials": {
        "qdrantApi": {
          "id": "9RJEDHoAHAOLsPwp",
          "name": "QdrantApi account 2"
        }
