        "command": "=ffmpeg -i /tmp/n8n_video_{{ $execution.id }}.mp4 -vn -acodec libmp3lame -ab 128k -y /tmp/n8n_audio_{{ $execution.id }}.mp3 && rm /tmp/n8n_video_{{ $execution.id }}.mp4",
        "options": {}
      },
      "type": "n8n-nodes-base.executeCommand",
