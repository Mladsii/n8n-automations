    {
      "parameters": {
        "jsCode": "// Получаем данные из предыдущих нод\nconst transcription = $('Whisper — транскрипция (API)').first().json;\nconst shareData = $('Создать публичную ссылку').first().json;\nconst webhookData = $('Webhook — приём видео').first().json;\n\nconst title = webhookData.body?.title || 'Без названия';\nconst description = webhookData.body?.description || '';\n\n// Получаем токен публичной ссылки из ответа Nextcloud OCS API\nconst shareToken = shareData.ocs?.data?.token || '';\nconst videoUrl = `https://nextcloud.agentura-soft.ru/index.php/s/${shareToken}/download`;\n\n// Собираем текст с таймкодами из segments\nlet textWithTimecodes = '';\n\nif (transcription.segments && Array.isArray(transcription.segments)) {\n  for (const seg of transcription.segments) {\n    const startSec = Math.floor(seg.start);\n    const min = Math.floor(startSec / 60);\n    const sec = (startSec % 60).toString().padStart(2, '0');\n    const timecode = `${min}:${sec}`;\n    textWithTimecodes += `(${timecode}) ${seg.text.trim()}\\n`;\n  }\n} else {\n  textWithTimecodes = transcription.text || '';\n}\n\n// Удаляем временный аудио-файл\ntry {\n  const execId = $execution.id;\n  require('fs').unlinkSync(`/tmp/n8n_audio_${execId}.mp3`);\n} catch(e) {}\n\nreturn [{\n  json: {\n    full_text: textWithTimecodes,\n    title: title,\n    description: description,\n    video_file_id: shareToken,\n    video_url: videoUrl\n  }\n}];"
      },
